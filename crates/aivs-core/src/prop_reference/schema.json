        "required": [
          "id",
          "count",
          "matches_definition",
          "clearly_visible",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "matches_definition": {
            "type": "boolean",
            "description": "The observable design matches the definition, with no visible contradiction. Hidden incidental features are not certified; describe them as unobservable in evidence."
          },
          "clearly_visible": {
            "type": "boolean",
            "description": "Enough of this part is visible to identify and count it. Every surface, internal joint and support need not be exposed. A wholly hidden part cannot pass."
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "relation",
          "object",
          "value",
          "matches_definition",
          "clearly_visible",
          "evidence"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "matches_definition": {
            "type": "boolean"
          },
          "clearly_visible": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "coherent_component_state": {
      "type": "boolean"
    },
    "connections_clear": {
      "type": "boolean",
      "description": "Declared relationships and source-essential functional connections are supported by visible evidence. Incidental joints or supports hidden by intended containment do not require proof."
    },
